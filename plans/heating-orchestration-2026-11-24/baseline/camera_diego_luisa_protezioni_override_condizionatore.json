{
  "source_entity_id": "automation.camera_diego_luisa_protezioni_override_condizionatore",
  "ha_config_hash": "fc301c998d0aea52",
  "validation": null,
  "config": {
    "id": "1795251172867",
    "alias": "Camera Diego Luisa - Protezioni override condizionatore",
    "description": "Anche in manuale: stop a 2700 W, dati potenza assenti/stantii, finestra aperta per 120 s o indisponibile per 30 s o arresto centrale. Override conservato dopo lo stop, nessuna ripartenza automatica immediata.",
    "triggers": [
      {
        "trigger": "numeric_state",
        "entity_id": "sensor.energy_meter_power_a_casa",
        "above": 2699.99
      },
      {
        "trigger": "state",
        "entity_id": "sensor.energy_meter_power_a_casa",
        "to": [
          "unknown",
          "unavailable"
        ]
      },
      {
        "trigger": "state",
        "entity_id": "binary_sensor.finestre_interne_camera_diego_luisa",
        "to": [
          "on",
          "unknown",
          "unavailable"
        ],
        "for": {
          "seconds": 30
        }
      },
      {
        "trigger": "state",
        "entity_id": "select.central_mode",
        "to": "Stopped"
      },
      {
        "trigger": "state",
        "entity_id": "climate.camera_diego_luisa_condizionatore_aria_stanza",
        "to": null
      },
      {
        "trigger": "time_pattern",
        "seconds": "/30"
      }
    ],
    "conditions": [
      {
        "condition": "state",
        "entity_id": "input_boolean.camera_diego_luisa_pdc_override",
        "state": "on"
      },
      {
        "condition": "state",
        "entity_id": "climate.camera_diego_luisa_condizionatore_aria_stanza",
        "state": [
          "heat",
          "cool",
          "auto",
          "dry",
          "fan_only",
          "heat_cool"
        ]
      },
      {
        "condition": "or",
        "conditions": [
          {
            "condition": "template",
            "value_template": "{% set p=states('sensor.energy_meter_power_a_casa')|float(none) %}{% set age=as_timestamp(now())-as_timestamp(states['sensor.energy_meter_power_a_casa'].last_reported,0) %}{{ p is none or p<0 or p>=2700 or age>45 or is_state('select.central_mode','Stopped') or false }}"
          },
          {
            "condition": "state",
            "entity_id": "binary_sensor.finestre_interne_camera_diego_luisa",
            "state": "on",
            "for": {
              "seconds": 120
            }
          },
          {
            "condition": "and",
            "conditions": [
              {
                "condition": "not",
                "conditions": [
                  {
                    "condition": "state",
                    "entity_id": "binary_sensor.finestre_interne_camera_diego_luisa",
                    "state": [
                      "on",
                      "off"
                    ]
                  }
                ]
              },
              {
                "condition": "template",
                "value_template": "{{ as_timestamp(now())-as_timestamp(states['binary_sensor.finestre_interne_camera_diego_luisa'].last_changed,0)>=30 }}"
              }
            ]
          }
        ]
      }
    ],
    "actions": [
      {
        "action": "climate.set_hvac_mode",
        "target": {
          "entity_id": "climate.camera_diego_luisa_pompa_di_calore"
        },
        "data": {
          "hvac_mode": "off"
        }
      },
      {
        "if": [
          {
            "condition": "not",
            "conditions": [
              {
                "condition": "state",
                "entity_id": "climate.camera_diego_luisa_condizionatore_aria_stanza",
                "state": "off"
              }
            ]
          }
        ],
        "then": [
          {
            "action": "climate.set_hvac_mode",
            "target": {
              "entity_id": "climate.camera_diego_luisa_condizionatore_aria_stanza"
            },
            "data": {
              "hvac_mode": "off"
            }
          }
        ]
      },
      {
        "wait_template": "{{ is_state('climate.camera_diego_luisa_condizionatore_aria_stanza','off') }}",
        "timeout": {
          "seconds": 20
        },
        "continue_on_timeout": true
      },
      {
        "if": [
          {
            "condition": "not",
            "conditions": [
              {
                "condition": "state",
                "entity_id": "climate.camera_diego_luisa_condizionatore_aria_stanza",
                "state": "off"
              }
            ]
          }
        ],
        "then": [
          {
            "action": "persistent_notification.create",
            "data": {
              "notification_id": "diego_luisa_pdc_spegnimento_non_confermato",
              "title": "Camera Diego Luisa: spegnimento non confermato",
              "message": "Il condizionatore non conferma OFF. L'override e la sospensione del radiatore restano attivi. Verificare il dispositivo e SmartThings."
            }
          },
          {
            "stop": "Spegnimento non confermato: nessun rilascio al radiatore",
            "error": true
          }
        ]
      },
      {
        "action": "input_boolean.turn_off",
        "target": {
          "entity_id": "input_boolean.camera_diego_luisa_pdc_in_gestione"
        }
      }
    ],
    "mode": "single",
    "max_exceeded": "silent",
    "trace": {
      "stored_traces": 20
    }
  }
}
