{
  "source_entity_id": "automation.camera_carlo_profilo_comfort_split_automatico",
  "ha_config_hash": "24db2881ddfde1a5",
  "validation": null,
  "config": {
    "id": "1795162110756",
    "alias": "Camera Carlo - Profilo comfort split automatico",
    "description": "Profili Europe/Rome solo con PDC automatica in gestione e split/vTherm in heat: 21–07 Quiet senza comando ventola, alette ferme; 07–09 low/vertical; 09–19 medium con scarto stanza ≥1 °C, low a ≤0,5 °C, mantiene velocità fra le soglie; 19–21 low/alette ferme. Scarto rispetto al setpoint del vTherm radiatore. Nessun comando di accensione, spegnimento o temperatura. Beep off. Display off dopo avvio e cambi funzione, attesa 5 s, verifica 8 s e secondo tentativo verificato. Controllo ogni minuto per recuperare eventi durante una sequenza; comandi solo se necessari. Disattivare questa automazione annulla la gestione dei profili. Override manuale condizionatore: precedenza per 120 minuti; sequenze automatiche interrotte prima dei comandi.",
    "triggers": [
      {
        "trigger": "state",
        "entity_id": "climate.camera_carlo_condizionatore",
        "to": "heat",
        "id": "avvio"
      },
      {
        "trigger": "switch.turned_on",
        "target": {
          "entity_id": [
            "input_boolean.camera_carlo_pdc_automatica",
            "input_boolean.camera_carlo_pdc_in_gestione",
            "switch.camera_carlo_condizionatore_illuminazione_del_display",
            "switch.camera_carlo_condizionatore_effetto_sonoro"
          ]
        },
        "id": "gestione_o_luci"
      },
      {
        "trigger": "temperature.changed",
        "target": {
          "entity_id": "sensor.temperatura_camera_carlo"
        },
        "options": {
          "threshold": {
            "type": "any"
          }
        },
        "id": "temperatura"
      },
      {
        "trigger": "state",
        "entity_id": "climate.trv_vtherm_camera_carlo",
        "attribute": "temperature",
        "id": "setpoint"
      },
      {
        "trigger": "state",
        "entity_id": "climate.camera_carlo_condizionatore",
        "attribute": "preset_mode",
        "id": "funzione"
      },
      {
        "trigger": "state",
        "entity_id": "climate.camera_carlo_condizionatore",
        "attribute": "fan_mode",
        "id": "funzione"
      },
      {
        "trigger": "state",
        "entity_id": "climate.camera_carlo_condizionatore",
        "attribute": "swing_mode",
        "id": "funzione"
      },
      {
        "trigger": "time",
        "at": [
          "07:00:00",
          "09:00:00",
          "19:00:00",
          "21:00:00"
        ],
        "id": "fascia"
      },
      {
        "trigger": "homeassistant",
        "event": "start",
        "id": "riavvio"
      },
      {
        "trigger": "time_pattern",
        "minutes": "/1",
        "id": "recupero"
      }
    ],
    "conditions": [
      {
        "condition": "state",
        "entity_id": "input_boolean.camera_carlo_pdc_override",
        "state": "off"
      },
      {
        "condition": "and",
        "conditions": [
          {
            "condition": "state",
            "entity_id": "input_boolean.camera_carlo_pdc_automatica",
            "state": "on"
          },
          {
            "condition": "state",
            "entity_id": "input_boolean.camera_carlo_pdc_in_gestione",
            "state": "on"
          },
          {
            "condition": "state",
            "entity_id": "climate.camera_carlo_condizionatore",
            "state": "heat"
          },
          {
            "condition": "state",
            "entity_id": "climate.camera_carlo_pompa_di_calore",
            "state": "heat"
          },
          {
            "condition": "state",
