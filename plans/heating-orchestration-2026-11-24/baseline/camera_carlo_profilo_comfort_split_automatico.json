            "state": "off"
          },
          {
            "condition": "state",
            "entity_id": "automation.camera_carlo_scelta_radiatore_o_pompa_di_calore",
            "state": "on"
          },
          {
            "condition": "numeric_state",
            "entity_id": "sensor.energy_meter_power_a_casa",
            "below": 2700
          }
        ]
      }
    ],
    "actions": [
      {
        "delay": {
          "seconds": 2
        }
      },
      {
        "condition": "state",
        "entity_id": "input_boolean.camera_carlo_pdc_override",
        "state": "off"
      },
      {
        "variables": {
          "desired_preset": "none",
          "desired_swing": "off",
          "desired_fan": "low"
        }
      },
      {
        "choose": [
          {
            "conditions": [
              {
                "condition": "time",
                "after": "21:00:00",
                "before": "07:00:00"
              }
            ],
            "sequence": [
              {
                "variables": {
                  "desired_preset": "quiet",
                  "desired_fan": "none"
                }
              }
            ]
          },
          {
            "conditions": [
              {
                "condition": "time",
                "after": "07:00:00",
                "before": "09:00:00"
              }
            ],
            "sequence": [
              {
                "variables": {
                  "desired_swing": "vertical"
                }
              }
            ]
          },
          {
            "conditions": [
              {
                "condition": "time",
                "after": "09:00:00",
                "before": "19:00:00"
              }
            ],
            "sequence": [
              {
                "variables": {
                  "desired_swing": "vertical",
                  "desired_fan": "{% set t = states('sensor.temperatura_camera_carlo') | float(none) %}{% set target = state_attr('climate.trv_vtherm_camera_carlo', 'temperature') | float(none) %}{% if t is none or target is none %}low{% else %}{% set gap = (target - t) | round(3) %}{{ 'medium' if gap >= 1 or (gap > 0.5 and is_state_attr('climate.camera_carlo_condizionatore', 'fan_mode', 'medium')) else 'low' }}{% endif %}"
                }
              }
            ]
          }
        ]
      },
      {
        "variables": {
          "functions_changed": "{{ state_attr('climate.camera_carlo_condizionatore', 'preset_mode') != desired_preset or state_attr('climate.camera_carlo_condizionatore', 'swing_mode') != desired_swing or (desired_preset == 'none' and state_attr('climate.camera_carlo_condizionatore', 'fan_mode') != desired_fan) }}"
